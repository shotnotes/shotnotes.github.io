# The Shot Notes XMP namespace for exiftool: use it with `exiftool -config
# shotnotes.config`. Version 1.0 of the namespace, named by its URI, which
# changes if a field ever changes its meaning. Documented in README.md.
my $ns = 'https://shotnotes.app/ns/1.0/';

# A piece of kit with the fields every kind shares, and the one that is its own.
sub kit {
    my %extra = @_;
    return (
        List => 'Bag',
        Struct => {
            NAMESPACE => { shotnotes => $ns },
            Manufacturer => { },
            Name => { },
            SerialNumber => { },
            Description => { },
            %extra,
        },
    );
}

%Image::ExifTool::UserDefined::ShotNotes = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-shotnotes', 2 => 'Image' },
    NAMESPACE => { shotnotes => $ns },
    WRITABLE => 'string',
    Id => { },
    Writer => { },
    Aperture => { Writable => 'real' },
    Shutter => { Writable => 'real' },
    Iso => { Writable => 'integer' },
    FocalLength => { Writable => 'real' },
    Lens => {
        Struct => {
            NAMESPACE => { shotnotes => $ns },
            Manufacturer => { },
            Name => { },
            Description => { },
            SerialNumber => { },
            FocalLengths => { Writable => 'real', List => 'Seq' },
            ApertureWidest => { Writable => 'real' },
            ApertureNarrowest => { Writable => 'real' },
        },
    },
    Location => { },
    Coordinates => {
        Struct => {
            NAMESPACE => { shotnotes => $ns },
            Latitude => { Writable => 'real' },
            Longitude => { Writable => 'real' },
            Altitude => { Writable => 'real' },
        },
    },
    Notes => { },
    Instant => { },
    UtcOffset => { },
    TimeZone => { },
    Lighting => { kit(GuideNumber => { }) },
    Filters => { kit(ThreadSize => { Writable => 'real' }) },
    Accessories => { kit() },
);

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        shotnotes => {
            SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::ShotNotes' },
        },
    },
);

1;
